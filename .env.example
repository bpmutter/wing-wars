# Everything here is OPTIONAL for local development.
# With nothing set, Wing Wars uses a local SQLite file (local.db) and a dev auth secret.
# Copy to .env.local and fill in when you want to point at real services.

# ── Database (Turso, free tier) ─────────────────────────────
# TURSO_DATABASE_URL=libsql://wing-wars-<you>.turso.io
# TURSO_AUTH_TOKEN=

# ── Auth (Better Auth) ─────────────────────────────────────
# Required when deployed. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The public URL of the site, e.g. https://wing-wars.vercel.app
# BETTER_AUTH_URL=

# ── Optional: "Continue with GitHub" ───────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
